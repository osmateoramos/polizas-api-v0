# Copie este archivo a .env y ajuste los valores. .env NO se versiona.
# Con estos valores el servicio arranca en local.

# Base de datos. La aplicación y Alembic leen la misma variable.
DATABASE_URL=sqlite:///app.db

# Secretos: en .env van los reales; aquí solo valores de ejemplo.
SECRETO_FIRMA=cambie-este-valor
CLAVE_API_REASEGURO=cambie-este-valor

# Modelo de riesgo y umbral de alto riesgo
RUTA_MODELO=modelo.pkl
UMBRAL_ALTO_RIESGO=0.6
